# mvp_v2 — Environment Variables
# Copy this file to .env and fill in real values

# --- HuggingFace Hub (Docling layout-model download during tree building) ---
# Without this: unauthenticated requests, lower rate limits, slower downloads.
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- VLM Server (self-hosted DGX / vLLM, Qwen2.5-VL-7B) ---
# Required — call_vlm() raises RuntimeError if LLM_API_KEY/VLM_API_KEY is unset.
LLM_BASE_URL=https://<VLM_HOST>/v1
LLM_API_KEY=
LLM_MODEL=Qwen2.5-VL-7B
